<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          Hide LeakCanary's separate launcher icon ("Leaks") from the home screen.
          LeakCanary registers this as <activity> in its own manifest; we override
          enabled=false via manifest merger so no launcher entry is created.
          See: https://square.github.io/leakcanary/recipes/#hiding-the-leakcanary-icon
        -->
        <activity
            android:name="leakcanary.internal.activity.LeakLauncherActivity"
            android:enabled="false"
            tools:replace="android:enabled" />
    </application>
</manifest>
