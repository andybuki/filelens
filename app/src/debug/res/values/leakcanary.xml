<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Hide LeakCanary's separate launcher icon ("Leaks") from the home screen.
      LeakCanary's LeakLauncherActivity <activity-alias> binds its enabled
      state to this boolean resource; overriding it to false here (debug-only)
      removes the launcher entry while keeping leak detection fully active.
    -->
    <bool name="leak_canary_add_launcher_icon">false</bool>
</resources>
